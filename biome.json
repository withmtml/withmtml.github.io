{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "formatter": {
    "enabled": true,
    "includes": [
      "./.vscode/*.json",
      "./.zed/*.json",
      "./src/**/*.ts",
      "./src/**/*.astro",
      "./public",
      "astro.config.mjs",
      "biome.json",
      "tsconfig.json"
    ],
    "indentStyle": "tab",
    "indentWidth": 2
  },
  "assist": {
    "actions": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "indentStyle": "tab",
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space"
    }
  },
  "html": {
    "formatter": { "enabled": true },
    "experimentalFullSupportEnabled": true
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "style": {
            "useConst": "off",
            "useImportType": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      },
      "javascript": {
        "globals": ["Astro"]
      },
      "formatter": {
        "enabled": true,
        "indentStyle": "tab"
      }
    }
  ]
}
